# ==========================================
# Telegram Bot Configuration
# ==========================================
# Token bot dari @BotFather
BOT_TOKEN=your_bot_token_here

# ID Telegram Admin (pisahkan dengan koma jika lebih dari satu)
# Dapatkan ID Anda via bot @userinfobot di Telegram
ADMIN_IDS=123456789

# Username Telegram Admin untuk tombol Bantuan & CS (tanpa @ atau dengan @)
ADMIN_CONTACT_USERNAME=your_admin_username

# (Opsional) Custom link kontak/WhatsApp (jika ingin diarahkan ke CS khusus)
# Contoh: https://t.me/your_admin_username atau https://wa.me/628123456789
ADMIN_CONTACT_URL=

# ==========================================
# Database & Storage Configuration
# ==========================================
# Path file database SQLite
DATABASE_PATH=./bot.db

# Direktori unduhan sementara (Zero-Persistence)
# Di Linux STB direkomendasikan: /tmp (di-mount sebagai tmpfs)
# Di Windows Dev biarkan kosong atau isi dengan: ./temp
TMP_DIR=

# ==========================================
# Media & Downloader Core
# ==========================================
# Binary path yt-dlp (default: yt-dlp jika sudah ada di system PATH)
# Di Windows bisa diarahkan ke file yt-dlp.exe atau biarkan 'yt-dlp'
YT_DLP_PATH=yt-dlp

# Binary path gallery-dl untuk unduhan foto & album (opsional, default: gallery-dl)
GALLERY_DL_PATH=gallery-dl

# Binary path ffmpeg (default: ffmpeg jika sudah ada di system PATH)
FFMPEG_PATH=ffmpeg

# Path file cookies opsional untuk bypass login wall Instagram / X (opsional)
COOKIES_PATH=

# Batas unduhan simultan (Default 2 untuk menjaga CPU/RAM STB HG680-P)
MAX_CONCURRENT_DOWNLOADS=2

# Batas maksimal ukuran file (MB) sebelum ditolak (Telegram Bot API limit 50MB)
MAX_FILE_SIZE_MB=48

# Timeout proses pengunduhan dalam milidetik (3 menit = 180000 ms)
DOWNLOAD_TIMEOUT_MS=180000

# ==========================================
# User Quota & Coin Economy Configuration
# ==========================================
# Biaya koin per unduhan media (khusus Free user, VIP & Admin gratis)
COIN_COST_DOWNLOAD=5

# Bonus koin untuk pengajak referral saat ada teman baru bergabung
COIN_REFERRAL_BONUS=500

# Bonus koin awal untuk pengguna baru yang baru mendaftar
COIN_INITIAL_BONUS=500

# Biaya koin fitur pencatatan keuangan AI (Gemini)
COIN_COST_EXPENSE_TEXT=5
COIN_COST_EXPENSE_RECEIPT=10

# Legacy limit configuration (opsional/cadangan)
FREE_DAILY_LIMIT=5
VIP_DAILY_LIMIT=50
REFERRAL_BONUS_LIMIT=5

# ==========================================
# QRIS Dinamis & Verifikasi Manual Admin
# ==========================================
# Payload string QRIS Statis dari merchant/e-wallet Anda (BCA, Dana, GoPay, OVO, ShopeePay, LinkAja, dll).
QRIS_STATIC_STRING=

# ==========================================
# STB Monitoring & Alerts
# ==========================================
ENABLE_THERMAL_ALERT=true
THERMAL_ALERT_TEMP_C=75
RAM_ALERT_PERCENT=90

# ==========================================
# Google Gemini AI (Pencatat Pengeluaran & OCR Struk)
# ==========================================
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
# Mendukung multi-key failover otomatis: pisahkan dengan koma jika punya key cadangan
# Contoh: GEMINI_API_KEY=AIzaSyPrimary...,AIzaSyBackup...
GEMINI_API_KEY=
